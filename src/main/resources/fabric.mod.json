{
    "schemaVersion": 1,
    "id": "factions",
    "version": "${version}",

    "name": "Factions Mod",
    "description": "Highly customizable, lightweight and elegant Factions mod for the Fabric loader",
    "authors": [
        "ickerio",
        "BlueZeeKing",
        "PyPylia",
        "joshes14"
    ],
    "contact": {
        "homepage": "https://github.com/joshes14/factions",
        "sources":  "https://github.com/joshes14/factions",
        "issues":   "https://github.com/joshes14/factions/issues"
    },

    "license": "MIT",
    "icon": "assets/factions/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            "io.icker.factions.FactionsMod"
        ],
        "client": [
            "io.icker.factions.client.FactionsClientMod"
        ]
    },
    "mixins": [
        "factions.mixins.json",
        {
            "config": "factions.client.mixins.json",
            "environment": "client"
        }
    ],

  "depends": {
    "fabricloader": ">=0.13.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*",
    "dynmap": ">=3.0",
    "squaremap": ">=1.0",
    "bluemap": ">=2.0"
  }
}
